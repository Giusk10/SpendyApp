# ===================================================================
# SpendyApp Environment Configuration Template
# COPY this file to .env and configure strong production credentials.
# NEVER commit the actual .env file or private keys to version control.
# ===================================================================

# Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=spendy
MYSQL_PASSWORD=change_this_to_a_strong_password_in_production
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password_in_production
MYSQL_DATABASE_AUTH=spendy_auth
MYSQL_DATABASE_EXPENSE=spendy_expense

# JWT RS256 Configuration
JWT_ISSUER=spendy-auth
JWT_AUDIENCE=spendy-app
JWT_EXPIRATION=900000

# Set to true ONLY in local dev/testing environments. In production, MUST be false!
JWT_ALLOW_EPHEMERAL_KEYS=false

# In production, specify RSA private/public keys either via PEM strings or file paths:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG..."
# Or use key files mounted in the container:
# JWT_PRIVATE_KEY_LOCATION=file:/path/to/private_key.pem
# JWT_PUBLIC_KEY_LOCATION=file:/path/to/public_key.pem

# Key Rotation: Active Key ID (kid) and transition keys
JWT_ACTIVE_KEY_ID=spendy-auth-key-1
# JWT_PREVIOUS_PUBLIC_KEYS="spendy-auth-key-0=-----BEGIN PUBLIC KEY-----..."

# CORS Allowlist (comma separated, NO wildcards with credentials!)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:7860,http://127.0.0.1:7860,http://127.0.0.1:8080,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8084,http://127.0.0.1:8084

# Rate Limiting (true/false)
RATE_LIMITING_ENABLED=true

# Service URIs
AUTH_SERVICE_URI=http://localhost:8081
EXPENSE_SERVICE_URI=http://localhost:8084

# JVM Options
JAVA_TOOL_OPTIONS=-Xms128m -Xmx256m
