# ===================================================================
# SpendyApp Environment Configuration Template
# COPY this file to .env and configure credentials.
# In production, use strong, randomly generated passwords and real RSA keys.
# NEVER commit the actual .env file or private keys to version control.
# ===================================================================

# -------------------------------------------------------------------
# Database Configuration (MySQL 8.4)
# -------------------------------------------------------------------
# For local Docker Compose, host is 'mysql'. For bare-metal dev, use 'localhost'.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=spendy_root_dev_password
MYSQL_DATABASE_AUTH=spendy_auth
MYSQL_DATABASE_EXPENSE=spendy_expense

# Standard Application User (Least Privilege: DML + Flyway DDL, no ALL PRIVILEGES):
MYSQL_USER=spendy
MYSQL_PASSWORD=spendy_dev_password

# Dedicated Service Accounts (Optional, recommended for strict schema isolation):
# If specified, Auth and Expense microservices will connect using isolated MySQL accounts,
# preventing cross-schema access (e.g. Expense cannot query or modify spendy_auth).
# MYSQL_AUTH_USER=spendy_auth
# MYSQL_AUTH_PASSWORD=spendy_auth_dev_password
# MYSQL_EXPENSE_USER=spendy_expense
# MYSQL_EXPENSE_PASSWORD=spendy_expense_dev_password

# -------------------------------------------------------------------
# Gateway Ingress Configuration
# -------------------------------------------------------------------
# Port published to the host machine (default: 7860)
GATEWAY_PORT=7860

# -------------------------------------------------------------------
# JWT Security Configuration (RS256 Asymmetric Cryptography)
# -------------------------------------------------------------------
JWT_ISSUER=spendy-auth
JWT_AUDIENCE=spendy-app
JWT_EXPIRATION=900000

# Set to true ONLY in local dev/testing environments if generating ephemeral keys.
# In production, MUST be set to false!
JWT_ALLOW_EPHEMERAL_KEYS=false

# Key Configuration (specify EITHER inline PEM string OR file URI location):
# Option A: Inline PEM strings
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG..."
# Option B: File URI location (recommended for Docker mounts and local dev)
# JWT_PRIVATE_KEY_LOCATION=file:keys/private_key.pem
# JWT_PUBLIC_KEY_LOCATION=file:keys/public_key.pem

# Key Rotation: Active Key ID (kid) and optional transition keys
JWT_ACTIVE_KEY_ID=spendy-auth-key-1
# JWT_PREVIOUS_PUBLIC_KEYS="spendy-auth-key-0=-----BEGIN PUBLIC KEY-----..."

# Optional JWKS URI (if resolving keys dynamically via Auth Service)
# JWT_JWK_SET_URI=http://auth-service:8081/rest/auth/jwks.json

# -------------------------------------------------------------------
# Network, CORS & Rate Limiting
# -------------------------------------------------------------------
# Comma-separated allowed origins (no wildcards with credentials!)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860,http://127.0.0.1:7860,http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting on IP (true/false)
RATE_LIMITING_ENABLED=true

# -------------------------------------------------------------------
# Microservice Internal Routing (Docker Compose defaults)
# -------------------------------------------------------------------
AUTH_SERVICE_URI=http://auth-service:8081
EXPENSE_SERVICE_URI=http://expense-service:8084

# -------------------------------------------------------------------
# JVM Memory & Garbage Collector Settings
# -------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Xms128m -Xmx256m
